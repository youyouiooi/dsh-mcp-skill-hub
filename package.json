{
  "name": "dsh-mcp-skill-hub",
  "version": "1.0.0",
  "description": "Manage MCP connections and Agent skills from one sidebar panel in DeepSeek Harness. · 在 DSH 侧边栏统一管理 MCP 连接与技能。",
  "type": "module",
  "license": "MIT",
  "author": "youyouiooi",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "skills",
    "agent-skills",
    "sidebar",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youyouiooi/dsh-mcp-skill-hub.git"
  },
  "homepage": "https://github.com/youyouiooi/dsh-mcp-skill-hub#readme",
  "bugs": {
    "url": "https://github.com/youyouiooi/dsh-mcp-skill-hub/issues"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "mcp-backend.js",
    "stdio-startup-guard.js",
    "client.js",
    "cordis.patch.yml",
    "ui/index.html",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
